Subject: [PATCH 31/39] =?UTF-8?q?feat(iris):=20=EC=9C=A0=EB=A6=AC=20?=
 =?UTF-8?q?=ED=9E=8C=ED=8A=B8=EB=A5=BC=20PTMaterial=20=EB=A1=9C=20?=
 =?UTF-8?q?=E2=80=94=20ThinSurface=20=EC=99=80=20IoR?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

IRIS 11번 (b)(c). 호스트(SketchUp/Enscape)는 아는데 Donut 의 Material 에
칸이 없어 버려지던 값 둘을 나릅니다.

  ThinSurface  ImportFromDonut 에 없어 늘 false(두께 있는 덩어리)였습니다.
               건축 유리는 거의 한 장의 면인데 매질로 다루니 광선이 들어가서
               안 나왔습니다 — 커튼월 너머가 통째로 하얗게 탔습니다.
  IoR          `//materialPT->IoR = material.ior;` 이 주석인 이유가 Donut 에
               필드가 없어서입니다. 전부 1.5 였습니다.

MaterialEx 에 IrisHintsSet/IrisThinSurface/IrisIoR 을 두고 ImportFromDonut
끝에서 옮깁니다. 힌트를 안 받은 재질은 IrisHintsSet 이 false 라 기존 동작
그대로입니다.

SceneBuilder(IRIS 쪽)는 RTXPT 타입을 모르므로 힌트만 내고, IrisScene.cpp 가
SetMaterialHintApplier 로 받아 옮겨 담습니다 — 결합이 그 한 파일에만
남습니다. 인스턴스 재질과 같은 방식입니다.

설정: IRIS > Glass > Thin glass (single-sided), 기본 켬. Enscape 의
IsSolidGlass 가 있으면 그쪽이 이기고 없을 때만 이 값입니다.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Rtxpt/Iris/IrisScene.cpp           | 20 ++++++++++++++++++++
 Rtxpt/Iris/IrisSettings.h          | 13 +++++++++++++
 Rtxpt/Materials/MaterialsBaker.cpp | 18 ++++++++++++++++++
 Rtxpt/Materials/MaterialsBaker.h   | 15 ++++++++++++++-
 Rtxpt/SampleUI.cpp                 | 13 +++++++++++++
 5 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/Rtxpt/Iris/IrisScene.cpp b/Rtxpt/Iris/IrisScene.cpp
index 326e5ee..3574461 100644
--- a/Rtxpt/Iris/IrisScene.cpp
+++ b/Rtxpt/Iris/IrisScene.cpp
@@ -4,6 +4,7 @@
 
 #include "IrisSettings.h"
 #include "../SampleCommon/LocalConfig.h"
+#include "../Materials/MaterialsBaker.h"   // IRIS: MaterialEx 에 힌트를 담습니다
 
 #include "iris/bridge/IrisBridge.h"
 #include "../SampleCommon/SampleCommon.h"
@@ -215,6 +216,22 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
             return loaded;
         });
 
+    // **Donut 머티리얼에 칸이 없는 값들**을 MaterialEx 로 옮겨 담습니다.
+    //
+    // SceneBuilder 는 RTXPT 타입을 모릅니다. 그래서 힌트만 내고, RTXPT 와의
+    // 결합은 이 파일 한 곳에 둡니다. 실제로 PTMaterial 에 들어가는 것은
+    // MaterialsBaker::ImportFromDonut 입니다(11번 (b)(c)).
+    builder.SetMaterialHintApplier(
+        [](Material& m, const iris::bridge::SceneBuilder::MaterialHints& h)
+        {
+            if (auto* ex = dynamic_cast<MaterialEx*>(&m))
+            {
+                ex->IrisHintsSet    = true;
+                ex->IrisThinSurface = h.thinSurface;
+                ex->IrisIoR         = h.ior;
+            }
+        });
+
     // 재질 상속을 인스턴스에 실어 줍니다. SceneBuilder 는 RTXPT 타입을 모르므로
     // 여기서 MeshInstanceEx 로 내려 꽂습니다.
     builder.SetInstanceMaterialApplier(
@@ -356,6 +373,7 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     // 그때 쓰는 값이라 숨기지 않고 설정으로 둡니다 (09번 8-i).
     builder.SetGlassRoughness(iris::Settings::Get().glassRoughness);
     builder.SetAlphaCutout(iris::Settings::Get().alphaCutout);
+    builder.SetGlassThinDefault(iris::Settings::Get().glassThin);
 
     // **태양이 있으면 하늘이 태양을 소유합니다.**
     //
@@ -434,6 +452,8 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
               stats.invisibleMaterials, stats.authorOpacity);
     log::info("IRIS: 텍스처 %zu개 · 그중 알파 컷아웃 %zu개 (프로브가 못 잰 것 %zu)",
               stats.textures, stats.cutoutMaterials, stats.cutoutUnmeasured);
+    log::info("IRIS: 유리 — 단면 %zu개 · 덩어리 %zu개 · 저작자 굴절률 %zu개",
+              stats.thinGlass, stats.solidGlass, stats.authorIor);
     log::info("IRIS: 조명 — 점 %zu · 스포트 %zu · 총 광속 %.0f lm · 발광 재질 %zu · Specular 지정 %zu",
               stats.pointLights, stats.spotLights, stats.lightLumens,
               stats.emissiveMaterials, stats.specularOverrides);
diff --git a/Rtxpt/Iris/IrisSettings.h b/Rtxpt/Iris/IrisSettings.h
index 99a8ab9..783ff8f 100644
--- a/Rtxpt/Iris/IrisSettings.h
+++ b/Rtxpt/Iris/IrisSettings.h
@@ -66,6 +66,17 @@ namespace iris
         // 적용됩니다.
         float glassRoughness = 0.05f;
 
+        // **단면인가 덩어리인가.** Enscape 가 `IsSolidGlass` 로 말해 주면 그
+        // 값이 이깁니다. 아무 말이 없을 때(세종 모델은 반투명 12개 중 0개)
+        // 이 값을 씁니다.
+        //
+        // 건축 유리는 거의 한 장의 면입니다. 두께 있는 매질로 다루면 광선이
+        // 들어가서 안 나오고 굴절·흡수가 어긋납니다. 그래서 기본은 단면입니다.
+        // 유리 탁자처럼 진짜 덩어리인 모델이면 꺼야 합니다.
+        //
+        // **씬을 다시 받아야** 적용됩니다.
+        bool glassThin = true;
+
         // ------------------------------------------------------ 텍스처 컷아웃
         //
         // 나뭇잎·난간·타공판의 구멍은 재질 알파가 아니라 **텍스처의 알파
@@ -130,6 +141,7 @@ namespace iris
             areaLightGeometry    = flag("area_light_geometry", areaLightGeometry);
             iesProfiles          = flag("ies_profiles", iesProfiles);
             glassRoughness       = num("glass_roughness", glassRoughness);
+            glassThin            = flag("glass_thin", glassThin);
             alphaCutout          = flag("alpha_cutout", alphaCutout);
         }
 
@@ -148,6 +160,7 @@ namespace iris
             root["area_light_geometry"]   = areaLightGeometry;
             root["ies_profiles"]          = iesProfiles;
             root["glass_roughness"]       = glassRoughness;
+            root["glass_thin"]            = glassThin;
             root["alpha_cutout"]          = alphaCutout;
 
             std::ofstream f(p, std::ios::trunc);
diff --git a/Rtxpt/Materials/MaterialsBaker.cpp b/Rtxpt/Materials/MaterialsBaker.cpp
index 6208bfc..bbf68c9 100644
--- a/Rtxpt/Materials/MaterialsBaker.cpp
+++ b/Rtxpt/Materials/MaterialsBaker.cpp
@@ -701,6 +701,24 @@ std::shared_ptr<PTMaterial> MaterialsBaker::ImportFromDonut(donut::engine::Mater
     materialPT->EnableAlphaTesting = (material.domain == MaterialDomain::AlphaTested || material.domain == MaterialDomain::TransmissiveAlphaTested);
     materialPT->EnableTransmission = (material.domain == MaterialDomain::Transmissive || material.domain == MaterialDomain::TransmissiveAlphaBlended || material.domain == MaterialDomain::TransmissiveAlphaTested);
 
+    // IRIS: Donut 의 Material 에 칸이 없어 위에서 못 옮긴 값들.
+    //
+    // 바로 위 `//materialPT->IoR = material.ior;` 이 주석인 이유가 그것입니다 —
+    // Donut 에 ior 필드가 없습니다. 호스트(SketchUp/Enscape)는 알고 있으므로
+    // MaterialEx 에 실어 여기서 꺼냅니다.
+    //
+    // ThinSurface 가 특히 중요합니다. 건축 유리는 거의 한 장의 면인데 기본값이
+    // false(두께 있는 덩어리)라, 광선이 매질에 들어가서 안 나옵니다.
+    if (const MaterialEx* irisEx = dynamic_cast<const MaterialEx*>(&material))
+    {
+        if (irisEx->IrisHintsSet)
+        {
+            materialPT->ThinSurface = irisEx->IrisThinSurface;
+            if (irisEx->IrisIoR > 1.0f)
+                materialPT->IoR = irisEx->IrisIoR;
+        }
+    }
+
     return materialPT;
 }
 
diff --git a/Rtxpt/Materials/MaterialsBaker.h b/Rtxpt/Materials/MaterialsBaker.h
index 344327f..6a693ae 100644
--- a/Rtxpt/Materials/MaterialsBaker.h
+++ b/Rtxpt/Materials/MaterialsBaker.h
@@ -219,7 +219,20 @@ struct PTMaterial : public PTMaterialBase
 
 struct MaterialEx : donut::engine::Material
 {
-    std::shared_ptr<PTMaterial> PTMaterial;              
+    std::shared_ptr<PTMaterial> PTMaterial;
+
+    // IRIS: 호스트는 아는데 Donut 의 Material 에 칸이 없는 값들.
+    //
+    // SceneBuilder(IRIS 쪽)는 RTXPT 타입을 모르므로 여기에 직접 못 씁니다.
+    // IrisScene.cpp 가 SetMaterialHintApplier 로 받아 옮겨 담고,
+    // ImportFromDonut 이 PTMaterial 로 넘깁니다 — 결합이 그 한 파일에만
+    // 남습니다(IRIS 11번 11.6).
+    //
+    // 힌트를 안 받은 재질(유리가 아닌 것)은 IrisHintsSet 이 false 이므로
+    // ImportFromDonut 이 건드리지 않습니다 — 기본 동작이 그대로입니다.
+    bool  IrisHintsSet    = false;
+    bool  IrisThinSurface = true;    // 단면으로 볼 것인가 (PTMaterial::ThinSurface)
+    float IrisIoR         = 0.0f;    // 0 이면 미지정 — PTMaterial 기본값 1.5 를 둡니다
 };
 
 class MaterialsBaker
