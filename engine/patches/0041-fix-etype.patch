     log::info("IRIS: 재질 상속 — 상속 버킷 %zu · 인스턴스 재질 적용 %zu곳",
               stats.inheritingBuckets, stats.overriddenSubInstances);
+    log::info("IRIS: 저작자가 유리가 아니라고 한 반투명 %zu개 (알파 블렌드)",
+              stats.authorTranslucent);
     log::info("IRIS: 유리로 해석한 머티리얼 %zu개 (그중 저작자 지정 %zu) · 안 보임 %zu · Enscape 불투명도 적용 %zu",
               stats.glassMaterials, stats.authorGlass,
               stats.invisibleMaterials, stats.authorOpacity);
