Content-Transfer-Encoding: 8bit

HDRI 환경맵에는 태양이 구워져 있습니다. 거기에 우리 방향광을 더하면 그림자가 둘이 됩니다 - 실외 모델에서 실제로 그렇게 나왔습니다. RTXPT 의 절차적 하늘(Q2RTX 대기 산란)에는 SunDir 이 있지만 시각 스칼라로만 계산합니다. 호스트 방향을 주입해 태양을 하나로 만듭니다.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 Rtxpt/Iris/IrisScene.cpp                      | 22 ++++++++++++++++---
 .../Lighting/Distant/SampleProceduralSky.cpp  | 15 +++++++++++++
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/Rtxpt/Iris/IrisScene.cpp b/Rtxpt/Iris/IrisScene.cpp
index ddf5a4b..2d1d392 100644
--- a/Rtxpt/Iris/IrisScene.cpp
+++ b/Rtxpt/Iris/IrisScene.cpp
@@ -5,6 +5,7 @@
 #include "../SampleCommon/LocalConfig.h"
 
 #include "iris/bridge/IrisBridge.h"
+#include "../SampleCommon/SampleCommon.h"
 #include "iris/bridge/SceneBuilder.h"
 #include "iris/protocol/IrisbReader.h"
 
@@ -222,9 +223,21 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     static auto s_meshCache = std::make_shared<iris::bridge::SceneBuilder::MeshCache>();
     builder.SetMeshCache(s_meshCache);
 
-    // SketchUp 은 광원을 주지 않습니다. 기본 하늘을 넣지 않으면 화면이 검게
-    // 나옵니다. 경로는 Assets 기준 상대경로입니다.
-    builder.SetEnvironmentMap("EnvironmentMaps/kloofendal_48d_partly_cloudy_puresky_4k_cube_bc6u.dds");
+    // **태양이 있으면 하늘이 태양을 소유합니다.**
+    //
+    // HDRI 환경맵에는 태양이 구워져 있습니다. 거기에 우리 방향광을 더하면
+    // 그림자가 둘이 됩니다 — 실외 모델에서 실제로 그렇게 나왔습니다.
+    //
+    // RTXPT 의 절차적 하늘(Q2RTX 대기 산란 모델)에는 태양이 있고, 우리가
+    // 방향을 주입할 수 있게 고쳤습니다(SampleProceduralSky). 그러면 태양은
+    // 하나이고, 하늘 색도 태양 고도를 따라갑니다.
+    //
+    // 태양이 없으면(실내·그림자 꺼짐·밤) 기존 HDRI 를 그대로 씁니다.
+    const bool sunUsable = src.sun.present && src.sun.shadows && src.sun.toward[2] > 0.0f;
+    builder.SetSkyOwnsSun(sunUsable);
+    builder.SetEnvironmentMap(sunUsable
+        ? std::string(c_EnvMapProcSky_Midday)
+        : std::string("EnvironmentMaps/kloofendal_48d_partly_cloudy_puresky_4k_cube_bc6u.dds"));
     auto graph = builder.Build(src, stats);
 
     // **만족시킬 수 없는 델타로 멀쩡한 씬을 갈아엎지 않습니다.**
@@ -257,6 +270,9 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     Trace("조명 — 점 %zu · 스포트 %zu · 총 광속 %.0f lm · 발광 재질 %zu",
           stats.pointLights, stats.spotLights, stats.lightLumens, stats.emissiveMaterials);
     Trace("거울 배치 노드 %zu개", stats.mirroredNodes);
+    // 하늘에 태양 방향을 넘깁니다. 절차적 하늘이 이것을 씁니다.
+    iris::bridge::IrisBridge::Get().SetSunDirection(stats.sunDirYUp, stats.hasSun);
+
     Trace("태양 %s%s", stats.hasSun ? "O" : "X",
           stats.hasSun ? (" (" + std::to_string((int)stats.sunIrradiance) + " lux)").c_str() : "");
     if (stats.meshesReused)
diff --git a/Rtxpt/Lighting/Distant/SampleProceduralSky.cpp b/Rtxpt/Lighting/Distant/SampleProceduralSky.cpp
index 667dfb1..c7d161a 100644
--- a/Rtxpt/Lighting/Distant/SampleProceduralSky.cpp
+++ b/Rtxpt/Lighting/Distant/SampleProceduralSky.cpp
@@ -9,6 +9,8 @@
 */
 
 #include "SampleProceduralSky.h"
+
+#include "iris/bridge/IrisBridge.h"
 #include <donut/engine/ShaderFactory.h>
 #include <donut/engine/FramebufferFactory.h>
 #include <donut/engine/CommonRenderPasses.h>
@@ -145,6 +147,19 @@ bool SampleProceduralSky::Update( double sceneTime, ProceduralSkyConstants & out
     const float rotateZ = dm::radians(m_sunEastWestRotation);
     affine3 earthRot = dm::rotation(float3(rotateX,0,0)) * dm::rotation(float3(0,rotateY,0)) * dm::rotation(float3(0,0,rotateZ)) ;
     sunDir = earthRot.transformVector(sunDir);
+
+    // IRIS: 호스트(SketchUp)가 태양 방향을 주면 그것을 씁니다.
+    //
+    // 이 하늘의 태양은 원래 시각 스칼라로만 정해집니다. 건축에서는 날짜·시각·
+    // 위치가 방향을 정하고 그것은 호스트 모델이 들고 있습니다.
+    //
+    // **그리고 태양은 하나여야 합니다.** 하늘에 태양이 있는데 방향광을 또
+    // 더하면 그림자가 둘이 됩니다 — 실외 모델에서 실제로 그렇게 나왔습니다.
+    {
+        float hostSun[3];
+        if (iris::bridge::IrisBridge::Get().GetSunDirection(hostSun))
+            sunDir = normalize(float3(hostSun[0], hostSun[1], hostSun[2]));
+    }
     outConstants.SunDir = sunDir;
 
     bool changes = memcmp(&outConstants, &m_lastConstants, sizeof(outConstants)) != 0;
