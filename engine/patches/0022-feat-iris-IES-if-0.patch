                                    donut::engine::ThreadPool* threadPool)
 {
@@ -223,6 +235,76 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     static auto s_meshCache = std::make_shared<iris::bridge::SceneBuilder::MeshCache>();
     builder.SetMeshCache(s_meshCache);
 
+    // **IES 배광을 텍스처로 굽습니다.**
+    //
+    // 브리지는 장치를 모르므로(순환 의존) 굽기와 광원에 달기를 여기서 합니다.
+    // 캐시는 **프로세스 수명**입니다 — 텍스처가 씬보다 오래 살아야 하고,
+    // 골프존 모델은 정의 4종이 같은 Bega 8331 하나를 씁니다.
+    //
+    // 폭 = 세로각(0..180), 높이 = 가로각(-180..180). 셰이더가 그렇게 읽습니다.
+    // 끄고 견줄 수 있게 둡니다 — 면광원과 같은 방식입니다. IRIS_IES=0.
+    bool iesOn = true;
+    {
+        char*  buf = nullptr;
+        size_t len = 0;
+        if (_dupenv_s(&buf, &len, "IRIS_IES") == 0 && buf)
+        {
+            iesOn = !(buf[0] == '0' || buf[0] == 'n' || buf[0] == 'N');
+            free(buf);
+        }
+        if (!iesOn)
+            Trace("IES 배광 — 끔 (IRIS_IES=0), 원뿔 근사로 갑니다");
+    }
+
+    if (iesOn)
+    builder.SetIesApplier(
+        [this](donut::engine::SpotLight& light, const std::string& key,
+               const float* data, uint32_t w, uint32_t h) -> bool
+        {
+            auto* ex = dynamic_cast<SpotLightEx*>(&light);
+            if (ex == nullptr || data == nullptr || w < 2 || h < 1)
+                return false;
+            if (m_Device == nullptr || m_DescriptorTable == nullptr)
+                return false;
+
+            auto it = s_iesProfiles.find(key);
+            if (it == s_iesProfiles.end())
+            {
+                nvrhi::TextureDesc td;
+                td.width             = w;
+                td.height            = h;
+                td.format            = nvrhi::Format::R32_FLOAT;
+                td.debugName         = "IRIS IES " + key;
+                td.initialState      = nvrhi::ResourceStates::ShaderResource;
+                td.keepInitialState  = true;
+                nvrhi::TextureHandle tex = m_Device->createTexture(td);
+                if (!tex)
+                {
+                    Trace("IES 텍스처를 만들지 못했습니다: %s", key.c_str());
+                    return false;
+                }
+
+                nvrhi::CommandListHandle cl = m_Device->createCommandList();
+                cl->open();
+                cl->writeTexture(tex, 0, 0, data, w * sizeof(float));
+                cl->close();
+                m_Device->executeCommandList(cl);
+
+                auto prof = std::make_shared<IesProfile>();
+                prof->texture = tex;
+                prof->handle  = m_DescriptorTable->CreateDescriptorHandle(
+                    nvrhi::BindingSetItem::Texture_SRV(0, tex));
+                it = s_iesProfiles.emplace(key, prof).first;
+                Trace("IES 배광 구움 — %s (%u x %u, 색인 %d)",
+                      key.c_str(), w, h, prof->handle.Get());
+            }
+
+            if (!it->second->handle.IsValid())
+                return false;
+            ex->profileTextureIndex = it->second->handle.Get();
+            return true;
+        });
+
     // **면광원을 발광 지오메트리로 낼 것인가.**
     //
     // 기본은 근사(88도 원뿔 + 등가 면적 구면)입니다. 그 근사는 라디언스와
@@ -297,6 +379,8 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     Trace("조명 — 점 %zu · 스포트 %zu · 면광원 %zu · 총 광속 %.0f lm · 발광 재질 %zu",
           stats.pointLights, stats.spotLights, stats.areaLights, stats.lightLumens,
           stats.emissiveMaterials);
+    if (stats.iesLights)
+        Trace("IES 배광 — %zu종을 광원 %zu개가 씁니다", stats.iesProfiles, stats.iesLights);
     Trace("거울 배치 노드 %zu개", stats.mirroredNodes);
     // 하늘에 태양 방향을 넘깁니다. 절차적 하늘이 이것을 씁니다.
     iris::bridge::IrisBridge::Get().SetSunDirection(stats.sunDirYUp, stats.hasSun);
