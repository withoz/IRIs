+// IRIS: 여기까지 와야 t_BindlessTextures(SceneBindings)와
+// s_MaterialSampler(SamplerBindings)가 둘 다 있습니다. LightShaping.hlsli 는
+// 위에서 이미 파싱됐으므로 거기서는 **선언만** 해 두었고, 정의를 여기 답니다.
+//
+// 원본이 이 코드를 `#if 0` 로 막아 둔 이유가 이것입니다 — 같은 헤더가
+// 바인딩 없는 곳(RTXDI · LightsBaker)에서도 포함됩니다.
+float IrisSampleIesProfile(int profileIndex, float2 uv)
+{
+    Texture2D<float4> tex = t_BindlessTextures[NonUniformResourceIndex(profileIndex)];
