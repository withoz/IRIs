diff --git a/Rtxpt/Iris/IrisTrace.h b/Rtxpt/Iris/IrisTrace.h
new file mode 100644
index 0000000..011e0f5
--- /dev/null
+++ b/Rtxpt/Iris/IrisTrace.h
@@ -0,0 +1,124 @@
+// IRIS — 진단용 파일 추적
+//
+// This software contains source code provided by NVIDIA Corporation.
+//
+// 왜 따로 있나
+//   RTXPT 를 `--captureSimple` 로 돌리면 stdout 이 비어 있고, 죽을 때는
+//   0xC0000409(abort) 로 버퍼가 날아가 아무것도 안 남습니다. 어디까지
+//   갔는지 알려면 **즉시 flush 하는 별도 경로**가 필요합니다.
+//
+//   환경변수 `IRIS_TRACE_LOG` 에 경로를 넣으면 켜집니다. 기본은 꺼져 있어
+//   제품 실행 중에 파일을 만들지 않습니다.
+//
+// 왜 헤더로 옮겼나 — **시작이 안 보였습니다**
+//   원래 이 코드는 `IrisScene.cpp` 안에 있었고, 엔진 로그를 파일로 흘리는
+//   갈고리를 **첫 `LoadIrisb` 에서** 걸었습니다. 그래서 씬을 한 번도 못
+//   읽으면 파일 자체가 안 생깁니다.
+//
+//   "렌더러를 새로 띄운 뒤 첫 씬이 조용히 버려진다"를 쫓을 때 바로 그것이
+//   막혔습니다 — 실패하는 구간(프로세스 시작 ~ 첫 씬)이 통째로 안 보였고,
+//   추적 파일이 없다는 사실만으로는 "씬이 안 왔다"인지 "갈고리가 아직
+//   안 걸렸다"인지 가릴 수 없었습니다.
+//
+//   이제 `InstallTraceHooks()` 를 프로세스 시작에서 한 번 부릅니다.
+//
+// CMake 가 GLOB 로 소스를 모으므로 .cpp 를 늘리면 다시 구성해야 합니다 —
+// IrisSettings.h 와 같은 이유로 헤더 하나로 끝냅니다.
+
+#pragma once
+
+#include <donut/core/log.h>
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <exception>
+#include <mutex>
+#include <string>
+
+namespace iris
+{
+    inline const char* TracePath()
+    {
+        static const char* path = []() -> const char* {
+            static std::string p;
+            char*  buf = nullptr;
+            size_t len = 0;
+            if (_dupenv_s(&buf, &len, "IRIS_TRACE_LOG") == 0 && buf)
+            {
+                p = buf;
+                free(buf);
+            }
+            return p.empty() ? nullptr : p.c_str();
+        }();
+        return path;
+    }
+
+    // **줄을 잃지 않게 잠급니다.**
+    //
+    // 파이프 수신 스레드와 렌더 스레드가 같이 씁니다. 잠그지 않으면
+    // 가끔 한 줄이 통째로 사라지는데, 없어진 줄이 "이 분기를 지났다" 는
+    // 증거일 때 곧장 엉뚱한 결론으로 갑니다 — 실제로 한 번 그랬습니다
+    // (포커스 문제를 고친 직후 확인에서 Animate 줄이 사라졌습니다).
+    inline std::mutex& TraceMutex()
+    {
+        static std::mutex m;
+        return m;
+    }
+
+    inline void Trace(const char* fmt, ...)
+    {
+        const char* path = TracePath();
+        if (!path)
+            return;
+        std::lock_guard<std::mutex> lock(TraceMutex());
+        FILE* f = nullptr;
+        if (fopen_s(&f, path, "a") != 0 || !f)
+            return;
+        va_list args;
+        va_start(args, fmt);
+        vfprintf(f, fmt, args);
+        va_end(args);
+        fputc('\n', f);
+        fflush(f);
+        fclose(f);
+    }
+
+    // 프로세스 시작에서 **한 번** 부릅니다. 두 번 불러도 안전합니다.
+    //
+    //   * 엔진 로그를 추적 파일로도 흘립니다. 전역 콜백이라 이 이후 엔진
+    //     전체의 로그가 남습니다.
+    //   * `std::terminate` 핸들러를 겁니다 — 잡히지 않은 예외로 abort 하면
+    //     이유가 안 남기 때문입니다.
+    inline void InstallTraceHooks()
+    {
+        static bool once = false;
+        if (once)
+            return;
+        once = true;
+
+        std::set_terminate([]()
+        {
+            try
+            {
+                if (auto e = std::current_exception())
+                    std::rethrow_exception(e);
+                Trace("!! std::terminate — 진행 중인 예외 없음");
+            }
+            catch (const std::exception& ex) { Trace("!! std::terminate — 예외: %s", ex.what()); }
+            catch (...)                      { Trace("!! std::terminate — 알 수 없는 예외"); }
+            std::abort();
+        });
+
+        const auto prev = donut::log::GetCallback();
+        donut::log::SetMinSeverity(donut::log::Severity::Debug);
+        donut::log::SetCallback([prev](donut::log::Severity s, const char* msg)
+        {
+            static const char* names[] = { "none", "debug", "info", "warn", "ERROR", "FATAL" };
+            Trace("[%s] %s", names[(int)s], msg);
+            if (prev) prev(s, msg);
+        });
+
+        Trace("=== IRIS 추적 시작 ===");
+    }
+}
