diff --git a/Rtxpt/Iris/IrisScene.cpp b/Rtxpt/Iris/IrisScene.cpp
new file mode 100644
index 0000000..06146ce
--- /dev/null
+++ b/Rtxpt/Iris/IrisScene.cpp
@@ -0,0 +1,200 @@
+// This software contains source code provided by NVIDIA Corporation.
+
+#include "IrisScene.h"
+
+#include "../SampleCommon/LocalConfig.h"
+
+#include "iris/bridge/SceneBuilder.h"
+#include "iris/protocol/IrisbReader.h"
+
+#include <donut/core/log.h>
+
+#include <cstdarg>
+#include <exception>
+#include <cstdlib>
+#include <string>
+#include <cstdio>
+
+using namespace donut;
+using namespace donut::engine;
+
+namespace
+{
+    // 진단용 파일 로그.
+    //
+    // RTXPT 를 --captureSimple 로 돌리면 stdout 이 비어 있고, 실패 시에는
+    // 0xC0000409(abort) 로 죽으면서 버퍼가 날아가 아무것도 남지 않습니다.
+    // 어디까지 갔는지 알려면 즉시 flush 하는 별도 경로가 필요합니다.
+    // 환경변수 IRIS_TRACE_LOG 에 경로를 넣으면 켜집니다. 기본은 꺼져 있어
+    // 제품 실행 중에 파일을 만들지 않습니다.
+    const char* TracePath()
+    {
+        static const char* path = []() -> const char* {
+            static std::string p;
+            char*  buf = nullptr;
+            size_t len = 0;
+            if (_dupenv_s(&buf, &len, "IRIS_TRACE_LOG") == 0 && buf)
+            {
+                p = buf;
+                free(buf);
+            }
+            return p.empty() ? nullptr : p.c_str();
+        }();
+        return path;
+    }
+
+    void Trace(const char* fmt, ...)
+    {
+        const char* path = TracePath();
+        if (!path)
+            return;
+        FILE* f = nullptr;
+        if (fopen_s(&f, path, "a") != 0 || !f)
+            return;
+        va_list args;
+        va_start(args, fmt);
+        vfprintf(f, fmt, args);
+        va_end(args);
+        fputc('\n', f);
+        fflush(f);
+        fclose(f);
+    }
+}
+
+bool IrisScene::LoadWithThreadPool(const std::filesystem::path& sceneFileName,
+                                   donut::engine::ThreadPool* threadPool)
+{
+    if (sceneFileName.extension() != ".irisb")
+        return ExtendedScene::LoadWithThreadPool(sceneFileName, threadPool);
+
+    // 예외가 여기를 빠져나가면 std::terminate -> abort(0xC0000409) 이고 이유가
+    // 남지 않습니다. .irisb 는 외부 입력이므로 반드시 막습니다.
+    try
+    {
+        return LoadIrisb(sceneFileName);
+    }
+    catch (const std::exception& e)
+    {
+        Trace("!! 예외: %s", e.what());
+        log::error("IRIS: .irisb 로딩 중 예외 — %s", e.what());
+        return false;
+    }
+    catch (...)
+    {
+        Trace("!! 알 수 없는 예외");
+        log::error("IRIS: .irisb 로딩 중 알 수 없는 예외");
+        return false;
+    }
+}
+
+bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName)
+{
+    // 엔진 로그를 우리 추적 파일로도 흘려보냅니다. --captureSimple 로 돌리면
+    // stdout 이 비어 있고, 죽을 때는 버퍼가 날아가 원인이 남지 않습니다.
+    // 전역 콜백이므로 이 이후 엔진 전체의 로그가 파일에 남습니다.
+    static bool logHooked = false;
+    if (!logHooked)
+    {
+        logHooked = true;
+
+        // 0xC0000409(abort) 로 죽으면 이유가 남지 않습니다. terminate 핸들러를
+        // 걸어 두면 잡히지 않은 예외의 메시지를 파일로 건질 수 있습니다.
+        std::set_terminate([]()
+        {
+            try
+            {
+                if (auto e = std::current_exception())
+                    std::rethrow_exception(e);
+                Trace("!! std::terminate — 진행 중인 예외 없음");
+            }
+            catch (const std::exception& ex) { Trace("!! std::terminate — 예외: %s", ex.what()); }
+            catch (...)                      { Trace("!! std::terminate — 알 수 없는 예외"); }
+            std::abort();
+        });
+
+        const auto prev = log::GetCallback();
+        log::SetMinSeverity(log::Severity::Debug);
+        log::SetCallback([prev](log::Severity s, const char* msg)
+        {
+            static const char* names[] = { "none", "debug", "info", "warn", "ERROR", "FATAL" };
+            Trace("[%s] %s", names[(int)s], msg);
+            if (prev) prev(s, msg);
+        });
+    }
+
+    Trace("=== LoadIrisb 시작: %s", sceneFileName.string().c_str());
+
+    // --- 읽기 ---
+    iris::protocol::Scene src;
+    const auto t0 = std::chrono::steady_clock::now();
+    const iris::protocol::ReadResult rr = iris::protocol::ReadIrisbFile(sceneFileName, src);
+    const double readMs = std::chrono::duration<double, std::milli>(
+                              std::chrono::steady_clock::now() - t0).count();
+
+    if (!rr.ok)
+    {
+        log::error("IRIS: .irisb 읽기 실패 — %s", rr.error.c_str());
+        return false;
+    }
+    for (const auto& w : rr.warnings)
+        log::warning("IRIS: %s", w.c_str());
+
+    Trace("읽기 OK %.1f ms — 정의 %zu · 머티리얼 %zu · 뷰 %zu · 블롭 %zu",
+          readMs, src.definitions.size(), src.materials.size(), src.views.size(), src.blob.size());
+
+    // --- 씬 그래프 구축 ---
+    iris::bridge::SceneBuilder builder(m_SceneTypeFactory, m_TextureCache,
+                                       sceneFileName.parent_path());
+    iris::bridge::BuildStats stats;
+    builder.SetTrace([](const std::string& s) { Trace("  [빌드] %s", s.c_str()); });
+
+    // SketchUp 은 광원을 주지 않습니다. 기본 하늘을 넣지 않으면 화면이 검게
+    // 나옵니다. 경로는 Assets 기준 상대경로입니다.
+    builder.SetEnvironmentMap("EnvironmentMaps/kloofendal_48d_partly_cloudy_puresky_4k_cube_bc6u.dds");
+    m_SceneGraph = builder.Build(src, stats);
+
+    Trace("구축 OK %.1f ms — 메시 %zu · 지오메트리 %zu · 인스턴스 %zu · 카메라 %zu · 삼각형 %llu",
+          stats.buildMs, stats.meshes, stats.geometries, stats.instances, stats.cameras,
+          (unsigned long long)stats.triangles);
+    for (const auto& w : stats.warnings)
+        Trace("  경고: %s", w.c_str());
+
+    for (const auto& w : stats.warnings)
+        log::warning("IRIS: %s", w.c_str());
+
+    log::info("IRIS: %s  읽기 %.1f ms + 구축 %.1f ms",
+              sceneFileName.filename().string().c_str(), readMs, stats.buildMs);
+    log::info("IRIS: 메시 %zu · 지오메트리 %zu · 인스턴스 %zu · 머티리얼 %zu(텍스처 %zu) · 카메라 %zu",
+              stats.meshes, stats.geometries, stats.instances,
+              stats.materials, stats.textures, stats.cameras);
+    log::info("IRIS: 삼각형 %llu · 정점 %llu · 최대 중첩 %zu",
+              (unsigned long long)stats.triangles, (unsigned long long)stats.vertices, stats.maxDepth);
+
+    // ExtendedScene 이 로딩 후에 하는 머티리얼 후처리를 같이 합니다.
+    // ProcessNodesRecursive 는 JSON 씬의 설정 노드를 다루는 것이라 .irisb 에는
+    // 해당 사항이 없어 건너뜁니다.
+    for (const auto& mat : m_SceneGraph->GetMaterials())
+        LocalConfig::PostMaterialLoad(*mat);
+
+    // 진단: 카메라가 실제로 어디를 보는지 확인합니다. RTXPT 는 cameras.back() 을
+    // 초기 카메라로 씁니다(Sample.cpp SceneLoaded) — 그래서 마지막 항목이 중요합니다.
+    // Refresh 가 필요하므로 추적이 켜져 있을 때만 합니다.
+    if (TracePath())
+    {
+        m_SceneGraph->Refresh(0);
+        const auto& cams = m_SceneGraph->GetCameras();
+        for (size_t i = 0; i < cams.size(); ++i)
+        {
+            const dm::affine3 v2w = cams[i]->GetViewToWorldMatrix();
+            Trace("카메라[%zu] pos=(%.3f, %.3f, %.3f) fwd=(%.4f, %.4f, %.4f) up=(%.4f, %.4f, %.4f)",
+                  i, v2w.m_translation.x, v2w.m_translation.y, v2w.m_translation.z,
+                  v2w.m_linear.row2.x, v2w.m_linear.row2.y, v2w.m_linear.row2.z,
+                  v2w.m_linear.row1.x, v2w.m_linear.row1.y, v2w.m_linear.row1.z);
+        }
+    }
+
+    Trace("LoadIrisb 반환 true (그래프 머티리얼 %zu · 메시 %zu · 인스턴스 %zu)",
+          m_SceneGraph->GetMaterials().size(), m_SceneGraph->GetMeshes().size(),
+          m_SceneGraph->GetMeshInstances().size());
+    return true;
+}
