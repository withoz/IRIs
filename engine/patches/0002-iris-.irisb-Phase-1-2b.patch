+// IRIS — .irisb 씬을 받는 Scene 파생 클래스
+//
+// This software contains source code provided by NVIDIA Corporation.
+//
+// 엔진 쪽 접착제입니다. 실제 변환은 IRIS 저장소의 iris_bridge(SceneBuilder)가
+// 하고, 여기서는 ExtendedScene 의 로딩 지점만 가로챕니다.
+//
+// 이 클래스가 엔진 안에 있는 이유는 ExtendedScene 을 상속해야 하기 때문입니다.
+// iris_bridge 를 여기 두면 RtxptCore 와 순환 의존이 됩니다.
+//
+// 확장자가 .irisb 가 아니면 전부 상위 구현으로 넘깁니다 — 기존 씬은 그대로
+// 동작합니다.
+
+#pragma once
+
+#include "../SampleCommon/ExtendedScene.h"
+
+class IrisScene : public ExtendedScene
+{
+public:
+    using ExtendedScene::ExtendedScene;
+
+    bool LoadWithThreadPool(const std::filesystem::path& sceneFileName,
+                            donut::engine::ThreadPool* threadPool) override;
+
+private:
+    bool LoadIrisb(const std::filesystem::path& sceneFileName);
+};
