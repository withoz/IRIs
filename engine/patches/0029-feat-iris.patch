 #if PIPELINE_BAKER_REVERT_TO_UBERSHADER
             const ShaderPermutation & permutation = m_ubershaderMaterial;
 #else
-            const ShaderPermutation & permutation = m_specializedPerMaterial[hitGroupInfo.GetShaderPermutationIndex()];
+            // IRIS 진단: 알파 테스트 재질이 들어오면 여기서 죽습니다.
+            // 첨자가 표를 넘는지, 셰이더 라이브러리가 비었는지 둘 다 봅니다 —
+            // 둘 중 어느 쪽이든 바로 아래 getShader 에서 널 참조입니다.
+            const int irisIdx = hitGroupInfo.GetShaderPermutationIndex();
+            if (irisIdx < 0 || irisIdx >= (int)m_specializedPerMaterial.size())
+            {
+                donut::log::error("IRIS: 퍼뮤테이션 첨자 %d 가 표 %zu 개를 넘습니다 ('%s', anyHit=%d) — 히트그룹을 건너뜁니다",
+                    irisIdx, m_specializedPerMaterial.size(), shaderPermutationName.c_str(), (int)hitGroupInfo.HasAnyHitShader);
+                continue;
+            }
+            const ShaderPermutation & permutation = m_specializedPerMaterial[irisIdx];
+            if (permutation.ShaderLibrary == nullptr)
+            {
+                donut::log::error("IRIS: 셰이더 라이브러리가 비었습니다 — 퍼뮤테이션 %d '%s' anyHit=%d 컴파일오류='%s'",
+                    irisIdx, shaderPermutationName.c_str(), (int)hitGroupInfo.HasAnyHitShader,
+                    permutation.US_compileError.c_str());
+                continue;
+            }
 #endif
             pipelineDesc.hitGroups.push_back(
                 {
