diff --git a/Rtxpt/OpacityMicroMap/OmmBaker.cpp b/Rtxpt/OpacityMicroMap/OmmBaker.cpp
index fb05400..30bacb3 100644
--- a/Rtxpt/OpacityMicroMap/OmmBaker.cpp
+++ b/Rtxpt/OpacityMicroMap/OmmBaker.cpp
@@ -123,7 +123,34 @@ void OmmBaker::CreateOpacityMicromaps(const donut::engine::Scene& scene)
             if (!material->EnableAlphaTesting)
                 continue;
 
+            // IRIS 진단 + 방어.
+            //
+            // 여기는 **알파 테스트 지오메트리에서만** 도는 길입니다. 라이브
+            // 링크로 알파 컷아웃 재질이 들어오면 렌더러가 이 근처에서 죽습니다.
+            //
+            // 두 가지가 비어 있을 수 있습니다:
+            //   - Donut 쪽 baseOrDiffuseTexture: PTMaterial 이 .material.json
+            //     에서 왔으면 PT 쪽에만 텍스처가 있고 Donut 쪽은 비어 있습니다.
+            //     그대로 ->path 를 하면 널 참조입니다.
+            //   - 엔진 TextureCache 의 CPU 이미지: IRIS 는 자체 텍스처 캐시에서
+            //     주므로(IrisScene.cpp) 엔진 캐시에 없을 수 있습니다.
+            if (geometry.material->baseOrDiffuseTexture == nullptr)
+            {
+                donut::log::warning("IRIS: OMM 건너뜀 — '%s' 에 Donut 베이스 텍스처가 없습니다",
+                                    material->Name.c_str());
+                continue;
+            }
             std::shared_ptr<TextureData> alphaTexture = m_textureCache->GetLoadedTexture(geometry.material->baseOrDiffuseTexture->path);
+            if (alphaTexture == nullptr)
+            {
+                donut::log::warning("IRIS: OMM 건너뜀 — '%s' 의 CPU 이미지가 엔진 캐시에 없습니다 (%s)",
+                                    material->Name.c_str(),
+                                    geometry.material->baseOrDiffuseTexture->path.c_str());
+                continue;
+            }
+            donut::log::info("IRIS: OMM 대상 '%s' — CPU이미지=%p GPU텍스처=%p",
+                             material->Name.c_str(), (void*)alphaTexture.get(),
+                             (void*)material->BaseTexture.Loaded->texture.Get());
 
             OmmBuildQueue::BuildInput::Geometry geom;
             geom.geometryIndexInMesh = i;
