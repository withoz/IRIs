diff --git a/Rtxpt/Materials/MaterialsBaker.cpp b/Rtxpt/Materials/MaterialsBaker.cpp
index 7a368d7..a914a14 100644
--- a/Rtxpt/Materials/MaterialsBaker.cpp
+++ b/Rtxpt/Materials/MaterialsBaker.cpp
@@ -1225,6 +1225,45 @@ bool MaterialsBaker::SaveSingle(PTMaterialBase & material)
     return true;
 }
 
+// IRIS: 지금 씬 재질에 해당하는 저장 파일만 모읍니다. 자세한 이유는 헤더 주석.
+std::vector<std::filesystem::path> MaterialsBaker::IrisOverrideFiles()
+{
+    std::vector<std::filesystem::path> found;
+    for (auto& materialPT : m_materials)
+    {
+        if (materialPT == nullptr)
+            continue;
+        std::error_code ec;
+        const std::filesystem::path p = GetMaterialStoragePath(*materialPT);
+        if (std::filesystem::exists(p, ec) && !ec)
+            found.push_back(p);
+    }
+    return found;
+}
+
+int MaterialsBaker::IrisDeleteOverrides()
+{
+    int removed = 0;
+    for (const auto& p : IrisOverrideFiles())
+    {
+        std::error_code ec;
+        if (std::filesystem::remove(p, ec) && !ec)
+        {
+            ++removed;
+            donut::log::info("IRIS: 재질 덮어쓰기를 지웠습니다 — %s", p.string().c_str());
+        }
+        else
+        {
+            donut::log::warning("IRIS: 재질 덮어쓰기를 못 지웠습니다 — %s (%s)",
+                                p.string().c_str(), ec.message().c_str());
+        }
+    }
+    if (removed > 0)
+        donut::log::info("IRIS: 덮어쓰기 %d개를 지웠습니다. SketchUp 에서 다시 보내면 "
+                         "호스트 값으로 돌아갑니다.", removed);
+    return removed;
+}
