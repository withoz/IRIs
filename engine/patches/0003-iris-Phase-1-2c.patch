@@ -64,14 +65,31 @@ namespace
 bool IrisScene::LoadWithThreadPool(const std::filesystem::path& sceneFileName,
                                    donut::engine::ThreadPool* threadPool)
 {
-    if (sceneFileName.extension() != ".irisb")
+    // 라이브 링크로 들어온 씬이 있으면 그것이 우선입니다. 파일이 아니라
+    // 파이프로 받은 바이트이므로 경로는 이름표일 뿐입니다.
+    const bool isLive = sceneFileName.filename().string() == iris::bridge::kLiveSceneName;
+    std::vector<uint8_t> live;
+    if (isLive || iris::bridge::IrisBridge::Get().HasPendingScene())
+        live = iris::bridge::IrisBridge::Get().TakePendingScene();
+
+    if (live.empty() && sceneFileName.extension() != ".irisb")
+    {
+        if (isLive)
+        {
+            log::error("IRIS: 라이브 씬을 요청했지만 받은 데이터가 없습니다");
+            return false;
+        }
         return ExtendedScene::LoadWithThreadPool(sceneFileName, threadPool);
+    }
 
     // 예외가 여기를 빠져나가면 std::terminate -> abort(0xC0000409) 이고 이유가
     // 남지 않습니다. .irisb 는 외부 입력이므로 반드시 막습니다.
     try
     {
-        return LoadIrisb(sceneFileName);
+        const bool ok = LoadIrisb(sceneFileName, live);
+        if (ok && !live.empty())
+            iris::bridge::IrisBridge::Get().NotifyApplied();
+        return ok;
     }
     catch (const std::exception& e)
     {
@@ -87,7 +105,8 @@ bool IrisScene::LoadWithThreadPool(const std::filesystem::path& sceneFileName,
     }
 }
 
-bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName)
+bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
+                          const std::vector<uint8_t>& bytes)
 {
     // 엔진 로그를 우리 추적 파일로도 흘려보냅니다. --captureSimple 로 돌리면
     // stdout 이 비어 있고, 죽을 때는 버퍼가 날아가 원인이 남지 않습니다.
@@ -122,12 +141,16 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName)
         });
     }
 
-    Trace("=== LoadIrisb 시작: %s", sceneFileName.string().c_str());
+    const bool live = !bytes.empty();
+    Trace("=== LoadIrisb 시작: %s%s", sceneFileName.string().c_str(),
+          live ? "  (라이브 링크)" : "");
 
     // --- 읽기 ---
     iris::protocol::Scene src;
     const auto t0 = std::chrono::steady_clock::now();
-    const iris::protocol::ReadResult rr = iris::protocol::ReadIrisbFile(sceneFileName, src);
+    const iris::protocol::ReadResult rr =
+        live ? iris::protocol::ReadIrisbMemory(bytes.data(), bytes.size(), src)
+             : iris::protocol::ReadIrisbFile(sceneFileName, src);
     const double readMs = std::chrono::duration<double, std::milli>(
                               std::chrono::steady_clock::now() - t0).count();
 
@@ -143,8 +166,20 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName)
           readMs, src.definitions.size(), src.materials.size(), src.views.size(), src.blob.size());
 
     // --- 씬 그래프 구축 ---
-    iris::bridge::SceneBuilder builder(m_SceneTypeFactory, m_TextureCache,
-                                       sceneFileName.parent_path());
+    // 텍스처 기준 경로. 파일에서 연 씬은 그 파일 옆이고, 라이브 링크는 호스트가
+    // Hello 로 알려준 곳입니다 (라이브 씬은 파일로 존재하지 않습니다).
+    std::filesystem::path texBase = sceneFileName.parent_path();
+    if (live)
+    {
+        const std::string base = iris::bridge::IrisBridge::Get().TextureBase();
+        if (!base.empty())
+            texBase = std::filesystem::path(
+                std::u8string(reinterpret_cast<const char8_t*>(base.c_str()), base.size()));
+        else
+            log::warning("IRIS: 호스트가 texture_base 를 주지 않아 텍스처를 찾지 못할 수 있습니다");
+    }
+
+    iris::bridge::SceneBuilder builder(m_SceneTypeFactory, m_TextureCache, texBase);
     iris::bridge::BuildStats stats;
     builder.SetTrace([](const std::string& s) { Trace("  [빌드] %s", s.c_str()); });
 
