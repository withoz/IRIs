+bool Sample::IsIrisScene() const
+{
+    return ::IsIrisScene(m_currentScenePath);
+}
+
+// IRIS 설정을 화면에 반영합니다.
+//
+// **한 군데서만 적용합니다.** 씬을 열 때와 사용자가 IRIS 패널을 움직일 때가
+// 같은 코드를 지나야, 열었을 때와 만졌을 때가 어긋나지 않습니다.
+void Sample::ApplyIrisSettings()
+{
+    const iris::Settings& s = iris::Settings::Get();
+
+    m_ui.ToneMappingParams.autoExposure         = s.autoExposure;
+    m_ui.ToneMappingParams.exposureCompensation = s.exposureCompensation;
+
+    // 하늘은 지금 없을 수도 있습니다. 기억을 지워 두면 PushIrisSky 가
+    // 생기는 즉시 — 또는 지금 바로 — 밀어 넣습니다.
+    m_irisSkyApplied = nullptr;
+    PushIrisSky();
+}
+
+void Sample::PushIrisSky()
+{
+    if (m_envMapBaker == nullptr)
+        return;
+    const SampleProceduralSky* sky = m_envMapBaker->GetProceduralSky().get();
+    if (sky == nullptr || sky == m_irisSkyApplied)
+        return;
+
+    m_envMapBaker->GetProceduralSky()->SetCloudDensityOffset(
+        iris::Settings::Get().CloudDensityOffset());
+    m_irisSkyApplied = sky;
+}
