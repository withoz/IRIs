diff --git a/Rtxpt/Iris/IrisSettings.h b/Rtxpt/Iris/IrisSettings.h
new file mode 100644
index 0000000..8bed163
--- /dev/null
+++ b/Rtxpt/Iris/IrisSettings.h
@@ -0,0 +1,159 @@
+// IRIS — 호스트가 줄 수 없는 설정
+//
+// This software contains source code provided by NVIDIA Corporation.
+//
+// SketchUp 그림자 패널에는 **날짜·시각·위치**만 있습니다. 날씨도, 노출도,
+// 조명을 어떻게 변환할지도 없습니다. 그래서 이 값들은 호스트가 정할 수
+// 없고 IRIS 가 가져야 합니다.
+//
+// 지금까지는 코드에 박혀 있거나(구름 1.0, 자동 노출 켬) 환경변수였습니다
+// (IRIS_AREA_LIGHTS, IRIS_IES). 견주려고 급히 둔 것이라 사용자가 바꿀 수
+// 없고, 껐다 켜면 사라졌습니다. 한곳에 모으고 파일에 남깁니다.
+//
+// 헤더 하나로 끝냅니다 — CMake 가 GLOB 로 소스를 모으므로 .cpp 를 늘리면
+// 다시 구성해야 합니다.
+
+#pragma once
+
+#include <json/json.h>
+
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+namespace iris
+{
+    struct Settings
+    {
+        // ------------------------------------------------------------ 하늘
+        //
+        // **사용자에게는 '흐림'으로 보입니다.** 엔진의 값은
+        // `cloud_density_offset` 인데 이름과 반대로 동작합니다 — 빼는
+        // 문턱값이라 1 이 맑음이고 0 은 하늘 전체가 옅은 안개입니다
+        // (SampleProceduralSky.hlsli 의
+        //  `Density = max(0, Density - offset) / (1.001 - offset)`).
+        //
+        // 이름만 보고 "0 으로 내리면 구름이 없어진다"고 읽었다가 한참
+        // 헤맸습니다(09번 8-d). 밖으로는 뒤집어 보여 줍니다.
+        //
+        //   흐림 0 = 맑음(offset 1)  ·  흐림 1 = 옅은 안개(offset 0)
+        float cloudiness = 0.0f;
+
+        // ------------------------------------------------------------ 노출
+        //
+        // 호스트가 준 광원 값은 Enscape 의 자동 노출 **위에서** 만들어진
+        // 것입니다. 고정 노출로 읽으면 타 버립니다(09번 8-c).
+        bool  autoExposure         = true;
+        float exposureCompensation = 0.0f;   // 스톱
+
+        // -------------------------------------------- 조명을 어떻게 변환할까
+        //
+        // 둘 다 **씬을 다시 받아야** 적용됩니다 — 씬 그래프를 만들 때
+        // 정해지기 때문입니다.
+        bool areaLightGeometry = true;   // 사각·선형을 발광 사각형으로 (09번 8-f)
+        bool iesProfiles       = true;   // IES 배광을 텍스처로 (09번 8-g)
+
+        // 엔진이 실제로 쓰는 값. 뒤집힌 의미를 한곳에서만 다룹니다.
+        [[nodiscard]] float CloudDensityOffset() const
+        {
+            const float c = (cloudiness < 0.0f) ? 0.0f : (cloudiness > 1.0f ? 1.0f : cloudiness);
+            return 1.0f - c;
+        }
+
+        // ------------------------------------------------------------ 보관
+
+        static std::filesystem::path Path()
+        {
+            char*  buf = nullptr;
+            size_t len = 0;
+            std::filesystem::path base;
+            if (_dupenv_s(&buf, &len, "LOCALAPPDATA") == 0 && buf)
+            {
+                base = buf;
+                free(buf);
+            }
+            if (base.empty())
+                return {};
+            return base / "IRIS" / "settings.json";
+        }
+
+        void Load()
+        {
+            const auto p = Path();
+            if (p.empty())
+                return;
+            std::ifstream f(p);
+            if (!f.good())
+                return;
+            Json::Value  root;
+            Json::CharReaderBuilder b;
+            std::string  err;
+            if (!Json::parseFromStream(b, f, &root, &err) || !root.isObject())
+                return;   // 깨진 파일은 조용히 무시하고 기본값으로 갑니다
+
+            auto num = [&](const char* k, float d) {
+                return root[k].isNumeric() ? root[k].asFloat() : d;
+            };
+            auto flag = [&](const char* k, bool d) {
+                return root[k].isBool() ? root[k].asBool() : d;
+            };
+
+            cloudiness           = num("cloudiness", cloudiness);
+            autoExposure         = flag("auto_exposure", autoExposure);
+            exposureCompensation = num("exposure_compensation", exposureCompensation);
+            areaLightGeometry    = flag("area_light_geometry", areaLightGeometry);
+            iesProfiles          = flag("ies_profiles", iesProfiles);
+        }
+
+        void Save() const
+        {
+            const auto p = Path();
+            if (p.empty())
+                return;
+            std::error_code ec;
+            std::filesystem::create_directories(p.parent_path(), ec);
+
+            Json::Value root;
+            root["cloudiness"]            = cloudiness;
+            root["auto_exposure"]         = autoExposure;
+            root["exposure_compensation"] = exposureCompensation;
+            root["area_light_geometry"]   = areaLightGeometry;
+            root["ies_profiles"]          = iesProfiles;
+
+            std::ofstream f(p, std::ios::trunc);
+            if (!f.good())
+                return;
+            Json::StreamWriterBuilder b;
+            b["indentation"] = "  ";
+            f << Json::writeString(b, root);
+        }
+
+        // 프로세스 하나에 하나. 처음 부를 때 파일에서 읽습니다.
+        static Settings& Get()
+        {
+            static Settings s = [] {
+                Settings t;
+                t.Load();
+                return t;
+            }();
+            return s;
+        }
+
+        // 환경변수는 **시험용 덮어쓰기**로 남깁니다. 설정 파일을 건드리지
+        // 않고 한 번만 다르게 띄울 수 있어야 A/B 가 편합니다.
+        //   IRIS_AREA_LIGHTS=0 · IRIS_IES=0
+        static bool EnvOverride(const char* name, bool current)
+        {
+            char*  buf = nullptr;
+            size_t len = 0;
+            bool   v   = current;
+            if (_dupenv_s(&buf, &len, name) == 0 && buf)
+            {
+                v = !(buf[0] == '0' || buf[0] == 'n' || buf[0] == 'N');
+                free(buf);
+            }
+            return v;
+        }
+    };
+}
