diff --git a/Rtxpt/Iris/IrisCrashReport.h b/Rtxpt/Iris/IrisCrashReport.h
new file mode 100644
index 0000000..9c65edf
--- /dev/null
+++ b/Rtxpt/Iris/IrisCrashReport.h
@@ -0,0 +1,184 @@
+// IRIS — 죽을 때 **어디서** 죽었는지 파일로 남깁니다
+//
+// 왜
+//   알파 테스트 재질이 하나라도 들어가면 렌더러가 세그폴트합니다(11번 (a)).
+//   로그를 심어 좁히는 방식으로는 한계에 닿았습니다 — 의심한 자리(서브
+//   인스턴스 준비·OMM·셰이더 퍼뮤테이션)가 전부 정상으로 나왔고, D3D12
+//   디버그 계층과 NVRHI 검증 계층조차 아무 메시지 없이 죽습니다.
+//
+//   이 머신에는 cdb·WinDbg 가 없습니다. 그래서 **프로세스가 스스로**
+//   자기 스택을 적게 합니다. Release PDB 가 있으므로 함수 이름과 줄
+//   번호까지 나옵니다.
+//
+//   Debug 빌드에서는 하나 더 필요합니다: assert 가 기본으로 **모달
+//   대화상자**를 띄웁니다. 화면 밖에서 돌리면 그대로 멈춰 버리므로
+//   CRT 보고를 가로채 같은 파일에 적고 끝냅니다.
+//
+// 헤더 하나로 끝냅니다 — RTXPT 의 CMake 가 소스를 GLOB 으로 모으므로
+// .cpp 를 늘리면 다시 구성해야 합니다. Dbghelp 도 pragma 로 링크합니다.
+//
+// 남기는 곳: IRIS_TRACE_LOG 가 있으면 그 옆의 `*.crash.txt`,
+//            없으면 실행 파일 옆 `iris_crash.txt`.
+
+#pragma once
+
+#ifdef _WIN32
+
+#include <windows.h>
+#include <DbgHelp.h>
+#include <crtdbg.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#pragma comment(lib, "Dbghelp.lib")
+
+namespace iris
+{
+    inline std::string CrashLogPath()
+    {
+        char*  buf = nullptr;
+        size_t len = 0;
+        std::string path;
+        if (_dupenv_s(&buf, &len, "IRIS_TRACE_LOG") == 0 && buf && buf[0])
+        {
+            path = buf;
+            free(buf);
+            const size_t dot = path.find_last_of('.');
+            path = (dot == std::string::npos) ? (path + ".crash.txt")
+                                              : (path.substr(0, dot) + ".crash.txt");
+            return path;
+        }
+        if (buf) free(buf);
+        return "iris_crash.txt";
+    }
+
+    // 크래시 처리 중에는 아무것도 가정하지 않습니다. 열고, 쓰고, 닫습니다.
+    inline void CrashWrite(const char* line)
+    {
+        static const std::string s_path = CrashLogPath();
+        FILE* f = nullptr;
+        if (fopen_s(&f, s_path.c_str(), "a") == 0 && f)
+        {
+            fputs(line, f);
+            fputc('\n', f);
+            fclose(f);
+        }
+        // 콘솔로도 흘립니다 — 리다이렉트해 두면 같이 잡힙니다.
+        fputs(line, stderr);
+        fputc('\n', stderr);
+    }
+
+    inline void CrashDumpStack(CONTEXT* ctx)
+    {
+        const HANDLE proc   = GetCurrentProcess();
+        const HANDLE thread = GetCurrentThread();
+
+        SymSetOptions(SYMOPT_LOAD_LINES | SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+        SymInitialize(proc, nullptr, TRUE);
+
+        STACKFRAME64 frame{};
+        frame.AddrPC.Offset    = ctx->Rip; frame.AddrPC.Mode    = AddrModeFlat;
+        frame.AddrFrame.Offset = ctx->Rbp; frame.AddrFrame.Mode = AddrModeFlat;
+        frame.AddrStack.Offset = ctx->Rsp; frame.AddrStack.Mode = AddrModeFlat;
+
+        char out[2048];
+        for (int i = 0; i < 64; ++i)
+        {
+            if (!StackWalk64(IMAGE_FILE_MACHINE_AMD64, proc, thread, &frame, ctx, nullptr,
+                             SymFunctionTableAccess64, SymGetModuleBase64, nullptr))
+                break;
+            if (frame.AddrPC.Offset == 0)
+                break;
+
+            alignas(SYMBOL_INFO) char symBuf[sizeof(SYMBOL_INFO) + MAX_SYM_NAME] = {};
+            SYMBOL_INFO* sym = reinterpret_cast<SYMBOL_INFO*>(symBuf);
+            sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+            sym->MaxNameLen   = MAX_SYM_NAME;
+
+            DWORD64 disp = 0;
+            const char* name = SymFromAddr(proc, frame.AddrPC.Offset, &disp, sym) ? sym->Name : "(이름 없음)";
+
+            // 어느 모듈인지도 적습니다 — 드라이버에서 죽었는지 우리 코드에서
+            // 죽었는지가 갈립니다.
+            IMAGEHLP_MODULE64 mod{};
+            mod.SizeOfStruct = sizeof(mod);
+            const char* modName = SymGetModuleInfo64(proc, frame.AddrPC.Offset, &mod) ? mod.ModuleName : "?";
+
+            IMAGEHLP_LINE64 line{};
+            line.SizeOfStruct = sizeof(line);
+            DWORD lineDisp = 0;
+            if (SymGetLineFromAddr64(proc, frame.AddrPC.Offset, &lineDisp, &line))
+                sprintf_s(out, "  #%02d %s!%s  (%s:%lu)", i, modName, name, line.FileName, line.LineNumber);
+            else
+                sprintf_s(out, "  #%02d %s!%s  [0x%llx]", i, modName, name,
+                          (unsigned long long)frame.AddrPC.Offset);
+            CrashWrite(out);
+        }
+        SymCleanup(proc);
+    }
+
+    inline LONG WINAPI CrashFilter(EXCEPTION_POINTERS* ep)
+    {
+        char head[512];
+        const DWORD code = ep && ep->ExceptionRecord ? ep->ExceptionRecord->ExceptionCode : 0;
+        CrashWrite("");
+        CrashWrite("================ IRIS: 렌더러가 죽었습니다 ================");
+        sprintf_s(head, "  예외 0x%08lX  주소 %p", (unsigned long)code,
+                  ep && ep->ExceptionRecord ? ep->ExceptionRecord->ExceptionAddress : nullptr);
+        CrashWrite(head);
+        if (code == EXCEPTION_ACCESS_VIOLATION && ep && ep->ExceptionRecord &&
+            ep->ExceptionRecord->NumberParameters >= 2)
+        {
+            sprintf_s(head, "  접근 위반: %s 주소 0x%llx",
+                      ep->ExceptionRecord->ExceptionInformation[0] ? "쓰기" : "읽기",
+                      (unsigned long long)ep->ExceptionRecord->ExceptionInformation[1]);
+            CrashWrite(head);
+        }
+        CrashWrite("  스택 (위가 죽은 자리):");
+        if (ep && ep->ContextRecord)
+            CrashDumpStack(ep->ContextRecord);
+        CrashWrite("==========================================================");
+        return EXCEPTION_EXECUTE_HANDLER;   // 조용히 끝냅니다 — 대화상자 없이
+    }
+
+    // Debug 빌드의 assert 를 가로챕니다. 기본값은 모달 대화상자라서
+    // 화면 밖에서 돌리면 그대로 멈춥니다.
+    inline int __cdecl CrashCrtReport(int type, char* msg, int* ret)
+    {
+        if (type == _CRT_ASSERT || type == _CRT_ERROR)
+        {
+            CrashWrite("");
+            CrashWrite("================ IRIS: assert 가 걸렸습니다 ================");
+            CrashWrite(msg ? msg : "(내용 없음)");
+            CrashWrite("  스택 (위가 걸린 자리):");
+            CONTEXT ctx{};
+            RtlCaptureContext(&ctx);
+            CrashDumpStack(&ctx);
+            CrashWrite("============================================================");
+            if (ret) *ret = 0;   // 디버거로 안 넘깁니다
+            _exit(3);
+        }
+        return FALSE;   // 나머지는 평소대로
+    }
+
+    inline void InstallCrashReporter()
+    {
+        SetUnhandledExceptionFilter(CrashFilter);
+        // 일부 CRT 경로는 예외를 삼키고 스스로 끝냅니다. 그것도 막습니다.
+        SetErrorMode(SEM_FAILCRITICALERRORS | SEM_NOGPFAULTERRORBOX);
+#ifdef _DEBUG
+        _CrtSetReportHook(CrashCrtReport);
+        _CrtSetReportMode(_CRT_ASSERT, _CRTDBG_MODE_FILE);
+        _CrtSetReportFile(_CRT_ASSERT, _CRTDBG_FILE_STDERR);
+        _CrtSetReportMode(_CRT_ERROR, _CRTDBG_MODE_FILE);
+        _CrtSetReportFile(_CRT_ERROR, _CRTDBG_FILE_STDERR);
+#endif
+        CrashWrite("");
+        CrashWrite("---- IRIS 크래시 보고기가 붙었습니다 ----");
+    }
+}
+
+#endif // _WIN32
