---
 Rtxpt/Lighting/Distant/SampleProceduralSky.h |  7 +++++++
 Rtxpt/Sample.cpp                             | 15 +++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/Rtxpt/Lighting/Distant/SampleProceduralSky.h b/Rtxpt/Lighting/Distant/SampleProceduralSky.h
index 1fe8cee..f636f58 100644
--- a/Rtxpt/Lighting/Distant/SampleProceduralSky.h
+++ b/Rtxpt/Lighting/Distant/SampleProceduralSky.h
@@ -57,6 +57,13 @@ public:
 
     void                            DebugGUI(float indent);
 
+    // IRIS: 구름 문턱값. **이름과 반대로 동작합니다** — 빼는 값이라
+    // 높을수록 구름이 적고, 1.0 이면 완전히 맑습니다(셰이더:
+    // `Density = max(0, Density - offset) / (1.001 - offset)`).
+    // 0.0 은 구름을 없애는 것이 아니라 하늘 전체를 옅은 안개로 덮습니다.
+    void                            SetCloudDensityOffset(float v)  { m_cloudDensityOffset = dm::clamp(v, 0.0f, 1.0f); }
+    float                           GetCloudDensityOffset() const   { return m_cloudDensityOffset; }
+
 private:
     double                          m_lastSceneTime = 0.0;
 
diff --git a/Rtxpt/Sample.cpp b/Rtxpt/Sample.cpp
index 9374557..1e81b50 100644
--- a/Rtxpt/Sample.cpp
+++ b/Rtxpt/Sample.cpp
@@ -601,6 +601,21 @@ void Sample::SceneLoaded( )
     {
         m_ui.ToneMappingParams.autoExposure = true;
         m_ui.ToneMappingParams.exposureCompensation = 0.0f;
+
+        // 하늘은 **맑게** 시작합니다.
+        //
+        // 엔진 기본값 0.75 는 짙은 구름을 만들고, 그러면 태양이 흩어져
+        // 그림자가 사라집니다 — 실외 모델에서 "그림자가 왜 없나"로 한참
+        // 헤맸습니다. 건축 프레젠테이션은 대개 맑은 날을 씁니다.
+        //
+        // ⚠ 이 값은 **빼는 문턱값**이라 이름과 반대입니다. 1.0 이 맑음이고
+        //   0.0 은 구름 없음이 아니라 하늘 전체에 옅은 안개입니다.
+        //
+        // SketchUp 그림자 패널에는 날짜·시각·위치만 있고 날씨가 없습니다.
+        // 그래서 이건 호스트가 아니라 IRIS 가 정할 자리입니다 — 나중에
+        // 자체 설정으로 뺍니다.
+        if (m_envMapBaker != nullptr && m_envMapBaker->GetProceduralSky() != nullptr)
+            m_envMapBaker->GetProceduralSky()->SetCloudDensityOffset(1.0f);
     }
 
     std::shared_ptr<EnvironmentLight> envLight = FindEnvironmentLight(m_lights);
