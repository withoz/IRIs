--- a/Rtxpt/Sample.h
+++ b/Rtxpt/Sample.h
@@ -102,6 +102,18 @@ public:
     virtual bool                            MouseScrollUpdate(double xoffset, double yoffset) override;
     virtual void                            Animate(float fElapsedTimeSeconds) override;
 
+    // IRIS: **최소화된 창에도 알립니다.**
+    //
+    // 창을 최소화하면 Donut 은 프레임을 통째로 건너뜁니다 —
+    // `ShouldRenderUnfocused()` 를 묻지도 않으므로 대기 중인 씬을 아무도
+    // 집어 가지 않습니다. 그렇다고 그 상태에서 씬을 올리는 것은 위험합니다:
+    // 창이 0x0 이라 렌더 타깃이 0 크기로 잡힐 수 있습니다.
+    //
+    // 대신 **최소화 중에도 도는 유일한 훅**(DeviceManager::m_callbacks.
+    // beforeFrame, RunMessageLoop 이 가시성과 무관하게 부릅니다)에서 작업
+    // 표시줄을 한 번 깜빡입니다. 복원하면 그때 바로 올라갑니다.
+    void                                    IrisBeforeFrame(donut::app::DeviceManager& dm);
+
     void                                    FillPTPipelineGlobalMacros(std::vector<donut::engine::ShaderMacro> & macros);
     bool                                    CreatePTPipeline(donut::engine::ShaderFactory& shaderFactory);
     void                                    DestroyOpacityMicromaps(nvrhi::ICommandList* commandList);
@@ -282,6 +294,10 @@ private:
     // 흐림을 이미 밀어 넣은 하늘 객체. 같은 객체면 다시 안 씁니다 —
     // 매 프레임 덮어쓰면 엔진의 Procedural Sky 슬라이더가 먹히지 않습니다.
     const class SampleProceduralSky*            m_irisSkyApplied = nullptr;
+
+    // 대기 중인 씬 하나에 대해 작업 표시줄을 **한 번만** 깜빡입니다.
+    // 매 프레임 부르면 계속 깜빡여 성가십니다.
+    bool                                        m_irisAttentionAsked = false;
     std::shared_ptr<LightsBaker>                m_lightsBaker;
     std::shared_ptr<class MaterialsBaker>       m_materialsBaker;
     std::shared_ptr<class OmmBaker>             m_ommBaker;
