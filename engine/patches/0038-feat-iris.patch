 Rtxpt/Sample.cpp | 43 +++++++++++++++++++++++++++++++++++++++++++
 Rtxpt/Sample.h   | 16 ++++++++++++++++
 2 files changed, 59 insertions(+)

diff --git a/Rtxpt/Sample.cpp b/Rtxpt/Sample.cpp
index d32b635..9dc2f2c 100644
--- a/Rtxpt/Sample.cpp
+++ b/Rtxpt/Sample.cpp
@@ -419,6 +419,22 @@ void Sample::Init(const std::string& preferredScene,
         log::warning("IRIS: 라이브 링크를 시작하지 못했습니다 — %s",
                      iris::bridge::IrisBridge::Get().LastError().c_str());
 
+    // IRIS: 최소화된 창에도 알리기 위한 훅.
+    //
+    // beforeFrame 은 RunMessageLoop 이 **가시성과 무관하게** 매 iteration
+    // 부르는 유일한 자리입니다. 이미 걸린 것이 있으면 이어 붙입니다.
+    if (donut::app::DeviceManager* dm = GetDeviceManager())
+    {
+        auto prev = dm->m_callbacks.beforeFrame;
+        dm->m_callbacks.beforeFrame =
+            [this, prev](donut::app::DeviceManager& d, uint32_t frame)
+            {
+                if (prev)
+                    prev(d, frame);
+                IrisBeforeFrame(d);
+            };
+    }
+
     std::string scene = FindPreferredScene(m_sceneFilesAvailable, preferredScene);
 
     // Select initial scene
@@ -1745,6 +1761,33 @@ void Sample::RtxdiSetupFrame(nvrhi::IFramebuffer* framebuffer, PathTracerCameraD
         m_scene, m_materialsBaker, m_ommBaker, m_subInstanceBuffer, bridgeParameters, m_bindingLayout, m_shaderDebug );
  }
 
+// IRIS: 최소화 중에도 도는 유일한 훅. Sample.h 의 선언에 이유가 있습니다.
+void Sample::IrisBeforeFrame(donut::app::DeviceManager& dm)
+{
+    if (!iris::bridge::IrisBridge::Get().HasPendingScene())
+    {
+        m_irisAttentionAsked = false;   // 반영됐습니다 — 다음 씬에 다시 알립니다
+        return;
+    }
+
+    GLFWwindow* window = dm.GetWindow();
+    if (window == nullptr)
+        return;
+
+    // 최소화가 아니면 이 프레임(또는 곧)에 반영됩니다. 알릴 것 없습니다.
+    if (glfwGetWindowAttrib(window, GLFW_ICONIFIED) == 0)
+        return;
+
+    if (m_irisAttentionAsked)
+        return;
+    m_irisAttentionAsked = true;
+
+    // 포커스를 뺏지 않습니다 — 작업 표시줄 단추만 깜빡입니다.
+    glfwRequestWindowAttention(window);
+    log::info("IRIS: 새 씬이 왔는데 창이 최소화되어 있습니다 — 복원하면 올라갑니다.");
+    iris::Trace("최소화 상태에서 대기 씬 — 작업 표시줄로 알립니다");
+}
+
 bool Sample::ShouldRenderUnfocused()
 {
     // IRIS: **호스트가 보낸 것이 있으면 포커스와 무관하게 프레임을 돌립니다.**
diff --git a/Rtxpt/Sample.h b/Rtxpt/Sample.h
