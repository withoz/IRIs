+            // 접어도 본문이 안 돕니다. 그러면 변경이 조용히 사라집니다.
+            // 실제로 파일과 화면이 어긋난 것을 이 검사에서 잡았습니다.
+            //
+            // 체크박스는 클릭 한 번이 곧 사건이고, 슬라이더는 손을 뗄 때
+            // IsItemDeactivatedAfterEdit 가 정확히 한 번 옵니다. 둘 다
+            // 미래에 기대지 않습니다.
+            auto sliderDone = [&] { return ImGui::IsItemDeactivatedAfterEdit(); };
 
             ImGui::SeparatorText("Sky");
             // 밖으로는 '흐림'입니다. 엔진의 cloud_density_offset 은 빼는
             // 문턱값이라 1 이 맑음인데, 그 뒤집힘은 Settings 안에 가둡니다.
             if (ImGui::SliderFloat("Cloudiness", &s.cloudiness, 0.0f, 1.0f, "%.2f"))
-                apply = m_irisSettingsDirty = true;
+                apply = true;
+            save |= sliderDone();
             if (ImGui::IsItemHovered())
                 ImGui::SetTooltip("0 = clear sky (sharp sun shadows)\n1 = overcast haze (shadows dissolve)\n\nSketchUp has no weather setting, so IRIS owns this.");
 
@@ -449,35 +465,31 @@ void SampleUI::buildUI(void)
             // 호스트 광원 값은 Enscape 의 자동 노출 위에서 만들어진 것이라
             // 고정 노출로 읽으면 타 버립니다(09번 8-c).
             if (ImGui::Checkbox("Auto exposure", &s.autoExposure))
-                apply = m_irisSettingsDirty = true;
+                apply = save = true;
             if (ImGui::IsItemHovered())
                 ImGui::SetTooltip("Host light values were authored under Enscape's auto exposure.\nTurning this off will blow out most scenes.");
             {
                 UI_SCOPED_DISABLE(!s.autoExposure);
                 if (ImGui::SliderFloat("Exposure compensation", &s.exposureCompensation, -4.0f, 4.0f, "%.2f EV"))
-                    apply = m_irisSettingsDirty = true;
+                    apply = true;
+                save |= sliderDone();
             }
 
             ImGui::SeparatorText("Light conversion");
             // 둘 다 씬 그래프를 만들 때 정해집니다 — 지금 화면은 안 바뀝니다.
             if (ImGui::Checkbox("Area lights as emissive geometry", &s.areaLightGeometry))
-                m_irisSettingsDirty = true;
+                save = true;
             if (ImGui::IsItemHovered())
                 ImGui::SetTooltip("Rectangular and linear lights become emissive quads\ninstead of equal-area spheres.\n\nApplies on the next sync from SketchUp.");
             if (ImGui::Checkbox("IES photometric profiles", &s.iesProfiles))
-                m_irisSettingsDirty = true;
+                save = true;
             if (ImGui::IsItemHovered())
                 ImGui::SetTooltip("Use the luminaire's measured distribution instead of a cone.\n\nApplies on the next sync from SketchUp.");
 
             if (apply)
                 m_app.ApplyIrisSettings();
-
-            // 손을 뗀 뒤에 한 번만 씁니다.
-            if (m_irisSettingsDirty && !ImGui::IsAnyItemActive())
-            {
+            if (save)
                 s.Save();
-                m_irisSettingsDirty = false;
-            }
         }
 
         if (ImGui::CollapsingHeader("Display and performance")) //, ImGuiTreeNodeFlags_DefaultOpen))
