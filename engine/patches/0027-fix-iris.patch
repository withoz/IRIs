diff --git a/Rtxpt/Iris/IrisScene.cpp b/Rtxpt/Iris/IrisScene.cpp
index 23cad6a..1ec0221 100644
--- a/Rtxpt/Iris/IrisScene.cpp
+++ b/Rtxpt/Iris/IrisScene.cpp
@@ -234,6 +234,36 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     // 만들어지므로 스스로는 아무것도 기억하지 못합니다. 텍스처 캐시와 같은
     // 이유이고, 호스트의 세션 번호가 이 캐시의 유효 범위와 짝을 이룹니다.
     static auto s_meshCache = std::make_shared<iris::bridge::SceneBuilder::MeshCache>();
+
+    // **모델이 바뀌면 버립니다.**
+    //
+    // 키가 정의 id(`def_<entityID>`)인데 **entityID 는 모델마다 다시
+    // 매겨집니다.** 다른 파일을 열면 같은 번호가 전혀 다른 정의를 가리키고,
+    // 캐시가 남의 지오메트리를 내줄 수 있습니다 — 오류 없이 조용히.
+    //
+    // 지금은 링크가 모델 전환을 감지해 전체를 다시 보내므로 실제로는
+    // 일어나지 않습니다(호스트 쪽 iris_link.rb / iris_probe.rb). 그런데 그
+    // 불변식이 **반대편에만** 있습니다. 링크가 나중에 똑똑해지면
+    // ("이 모델은 전에 봤으니 재사용") 여기가 조용히 뚫립니다.
+    //
+    // 같은 날 호스트 쪽에서 정확히 그 사고가 났습니다 — 모델 전환을
+    // 감지하고도 태양 재사용 경로가 이전 모델의 씬을 다시 보냈습니다.
+    // 그래서 문을 두 군데 답니다.
+    //
+    // ⚠ 저장 안 한 모델은 `path` 가 비어 제목으로만 갈립니다. 제목까지 같은
+    //   빈 모델 둘은 구별 못 합니다 — 그때는 링크 쪽 판정에 기댑니다.
+    {
+        static std::string s_meshCacheModel;
+        const std::string key = src.sourceFile + "|" + src.sourceTitle;
+        if (key != s_meshCacheModel)
+        {
+            if (!s_meshCacheModel.empty() && !s_meshCache->meshes.empty())
+                Trace("모델이 바뀌었습니다 — 메시 캐시 %zu개를 버립니다",
+                      s_meshCache->meshes.size());
+            s_meshCache = std::make_shared<iris::bridge::SceneBuilder::MeshCache>();
+            s_meshCacheModel = key;
+        }
+    }
     builder.SetMeshCache(s_meshCache);
 
     // **IES 배광을 텍스처로 굽습니다.**
