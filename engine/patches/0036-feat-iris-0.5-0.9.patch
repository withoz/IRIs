 3 files changed, 112 insertions(+), 3 deletions(-)

diff --git a/Rtxpt/Iris/IrisScene.cpp b/Rtxpt/Iris/IrisScene.cpp
index 3574461..d1458f8 100644
--- a/Rtxpt/Iris/IrisScene.cpp
+++ b/Rtxpt/Iris/IrisScene.cpp
@@ -205,13 +205,16 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     // Reset() 은 맵만 비우므로 우리가 shared_ptr 을 들고 있으면 살아남습니다.
     auto* cache = m_TextureCache.get();
     builder.SetTextureLoader(
-        [cache](const std::filesystem::path& p) -> std::shared_ptr<LoadedTexture>
+        [cache](const std::filesystem::path& p, bool sRGB) -> std::shared_ptr<LoadedTexture>
         {
             auto& bridge = iris::bridge::IrisBridge::Get();
-            const std::string key = p.generic_string();
+            // 노멀맵은 선형, 색 텍스처는 sRGB 입니다. 키에 넣어 두지 않으면
+            // 같은 파일을 두 해석으로 쓸 때 먼저 온 쪽이 이깁니다 —
+            // 지금은 그런 경우가 없지만 캐시가 조용히 틀리면 안 됩니다.
+            const std::string key = p.generic_string() + (sRGB ? "|s" : "|l");
             if (auto hit = bridge.FindTexture(key))
                 return hit;
-            auto loaded = cache ? cache->LoadTextureFromFileDeferred(p, true) : nullptr;
+            auto loaded = cache ? cache->LoadTextureFromFileDeferred(p, sRGB) : nullptr;
             bridge.CacheTexture(key, loaded);
             return loaded;
         });
@@ -229,6 +232,7 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
                 ex->IrisHintsSet    = true;
                 ex->IrisThinSurface = h.thinSurface;
                 ex->IrisIoR         = h.ior;
+                ex->IrisIgnoreMeshTangentSpace = h.ignoreMeshTangentSpace;
             }
         });
 
@@ -374,6 +378,9 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
     builder.SetGlassRoughness(iris::Settings::Get().glassRoughness);
     builder.SetAlphaCutout(iris::Settings::Get().alphaCutout);
     builder.SetGlassThinDefault(iris::Settings::Get().glassThin);
+    builder.SetBumpStrength(iris::Settings::Get().bumpStrength);
+    builder.SetRoughnessDefault(iris::Settings::Get().roughnessDefault);
+    builder.SetSurfaceNameRules(iris::Settings::Get().surfaceNameRules);
 
     // **태양이 있으면 하늘이 태양을 소유합니다.**
     //
@@ -454,6 +461,30 @@ bool IrisScene::LoadIrisb(const std::filesystem::path& sceneFileName,
               stats.textures, stats.cutoutMaterials, stats.cutoutUnmeasured);
     log::info("IRIS: 유리 — 단면 %zu개 · 덩어리 %zu개 · 저작자 굴절률 %zu개",
               stats.thinGlass, stats.solidGlass, stats.authorIor);
+    log::info("IRIS: 범프 — 노멀맵 %zu개 (디퓨즈에서 구움) · 쓸 그림이 없어 건너뜀 %zu개",
+              stats.bumpMaterials, stats.bumpSkipped);
+
+    // **어떤 규칙이 왜 걸렸는지.** 추측 규칙은 조용히 틀리기 쉽습니다 —
+    // 화면만 보고는 "재질 12개가 이름 규칙으로 가죽 판정" 을 알 수 없습니다.
+    // A/B 할 때 바뀐 값이 정말 건너왔는지도 이 줄로 확인합니다. 그래서
+    // 추적 파일에도 같이 남깁니다.
+    {
+        std::string detail;
+        for (const auto& entry : stats.surfaceRules)
+        {
+            if (!detail.empty())
+                detail += " · ";
+            detail += entry.first + " " + std::to_string(entry.second) + "개";
+        }
+        char line[1024];
+        snprintf(line, sizeof(line),
+                 "IRIS: 거칠기 추측 — 기본값 %.2f 로 간 재질 %zu개%s%s",
+                 iris::Settings::Get().roughnessDefault, stats.surfaceDefaulted,
+                 detail.empty() ? " (이름 규칙 꺼짐 또는 걸린 것 없음)" : " · 이름 규칙: ",
+                 detail.c_str());
+        log::info("%s", line);
+        Trace("%s", line);
+    }
     log::info("IRIS: 조명 — 점 %zu · 스포트 %zu · 총 광속 %.0f lm · 발광 재질 %zu · Specular 지정 %zu",
               stats.pointLights, stats.spotLights, stats.lightLumens,
               stats.emissiveMaterials, stats.specularOverrides);
diff --git a/Rtxpt/Iris/IrisSettings.h b/Rtxpt/Iris/IrisSettings.h
