         // **씬을 다시 받아야** 적용됩니다.
         bool glassThin = true;
 
+        // ------------------------------------------------------------ 범프
+        //
+        // Enscape 의 `BumpAmount` 는 0.1~3.0 입니다. 엔진의
+        // `normalTextureScale` 과 척도가 달라 대응은 **가정**입니다 —
+        // 최대값이 1.0 이 되도록 옮긴 뒤 이 값을 한 번 더 곱합니다.
+        // 화면으로 맞추라고 밖에 뺐습니다(11번 (d)).
+        //
+        // **씬을 다시 받아야** 적용됩니다.
+        float bumpStrength = 1.0f;
+
+        // --------------------------------------------------- 거칠기 기본값
+        //
+        // **Enscape 값이 없는 재질**(골프존 모델은 135개 중 109개)의 거칠기입니다.
+        //
+        // 지금까지 0.5 였는데 근거가 없었습니다. 같은 모델에서 Enscape 값이
+        // **있는** 재질 27벌을 세어 보니 0.90 에 10개가 몰려 있고, 그 10개는
+        // 잔디·돌·라미네이트·레이스웨이처럼 서로 전혀 다른 재질인데
+        // `R=0.900 M=0.000 S=0.500` 이 한 글자도 다르지 않았습니다. 그중 4개는
+        // SELF_ILLUMINATED — 발광면은 거칠기가 안 보여 일부러 맞출 이유가
+        // 없는데도 정확히 0.900 입니다. **Enscape 의 기본값**으로 봅니다
+        // (out/sketchup/rough_probe.txt · SurfaceGuess.h).
+        //
+        // **씬을 다시 받아야** 적용됩니다.
+        float roughnessDefault = 0.9f;
+
+        // 이름으로 거칠기를 덜어 낼 것인가 — 거울·크롬·타일·대리석·가죽·목재.
+        // 표는 **기본값보다 반짝이는 것만** 담습니다(11번 (g)).
+        // **씬을 다시 받아야** 적용됩니다.
+        bool surfaceNameRules = true;
+
         // ------------------------------------------------------ 텍스처 컷아웃
         //
         // 나뭇잎·난간·타공판의 구멍은 재질 알파가 아니라 **텍스처의 알파
@@ -142,7 +172,10 @@ namespace iris
             iesProfiles          = flag("ies_profiles", iesProfiles);
             glassRoughness       = num("glass_roughness", glassRoughness);
             glassThin            = flag("glass_thin", glassThin);
