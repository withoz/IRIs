씬 카메라가 선택돼 있으면 Sample::Animate 가 매 프레임 UpdateCameraFromScene
으로 덮어써서 호스트 시점이 무시된다. 라이브 링크가 도는 동안에는 자유
카메라(인덱스 0)여야 한다.
---
 Rtxpt/Sample.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/Rtxpt/Sample.cpp b/Rtxpt/Sample.cpp
index 66016d8..e83da71 100644
--- a/Rtxpt/Sample.cpp
+++ b/Rtxpt/Sample.cpp
@@ -818,6 +818,15 @@ void Sample::Animate(float fElapsedTimeSeconds)
             }
             m_cameraVerticalFOV = dm::radians(verticalFovDeg);
 
+            // 씬 카메라가 선택돼 있으면 아래에서 매 프레임 덮어씁니다.
+            // 라이브 링크가 켜져 있는 동안에는 자유 카메라(0)여야 합니다.
+            if (m_selectedCameraIndex != 0)
+            {
+                log::info("IRIS: 씬 카메라(%d)가 선택돼 있어 자유 카메라로 되돌립니다 — "
+                          "호스트 시점을 따라가려면 그래야 합니다", m_selectedCameraIndex);
+                m_selectedCameraIndex = 0;
+            }
+
             m_ui.ResetAccumulation = true;
         }
     }
